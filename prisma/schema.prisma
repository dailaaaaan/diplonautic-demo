// Esquema de la base de datos: cada "model" es una tabla.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  EMPLOYEE
  ADMIN
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EMPLOYEE)
  // Un empleado desactivado conserva sus datos pero no puede iniciar sesión.
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  threads      Thread[]
  replies      Reply[]
}

model Session {
  // Hash del token que viaja en la cookie; el token en claro no se guarda.
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum Category {
  QUESTION
  NOTICE
  INCIDENT
}

model Thread {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  category  Category
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  replies   Reply[]
}

model Reply {
  id        Int      @id @default(autoincrement())
  body      String
  threadId  Int
  // Al borrar un hilo se borran también sus respuestas.
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}
